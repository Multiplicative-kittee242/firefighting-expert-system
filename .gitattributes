# Line endings (Windows-originated legacy project)
* text=auto

# Source and build files - always LF in the repository
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.clp text eol=lf
*.md text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.dll binary
*.jar binary
*.zip binary
*.gif binary
*.png binary
*.class binary

# Merge strategies
*.java merge=union
