# Gradle
.gradle/
build/

# Java / compiled artifacts
*.class
*.jar
*.war
*.ear
# Both negations MUST stay below the broad *.jar above: git applies the last matching pattern, so a
# negation placed before the rule it overrides silently does nothing (which is exactly how the Gradle
# wrapper jar went missing from the repo — breaking ./gradlew on every fresh clone, CI and worktrees
# included, while still working locally where the file happens to exist on disk).
!gradle/wrapper/gradle-wrapper.jar
!lib/*.jar

# IDE (IntelliJ IDEA)
.idea/
*.iml
*.ipr
*.iws
out/

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
hs_err_pid*

# Portable 32-bit JRE (downloaded/extracted automatically by the build).
jre-17-32/

# git-bash crash dump artifact
bash.exe.stackdump

# agents
mcps/
.claude
